{
  "manifest_version": 3,
  "name": "闪耀优俊少女 · 种马搜索器",
  "version": "0.10.9",
  "description": "在 Chrome、Edge 和 360 浏览器的吗哩吗哩工具箱内识别因子要求，并按角色、星级和优先级搜索排序好友种马。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://game.bilibili.com/*",
    "https://api.game.bilibili.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-48.png"],
      "matches": ["https://game.bilibili.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://game.bilibili.com/tool/pd*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://game.bilibili.com/tool/pd*"],
      "js": ["ranking.js", "gold-skill-map.js", "traditional-name-map.js", "factor-recognizer.js", "request-guard.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
